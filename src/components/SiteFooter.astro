---
import { EMAIL, PUBLICATIONS, SITE, SOCIALS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="shell py-8 md:py-10">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="text-[0.9375rem] font-semibold uppercase tracking-[0.08em]">Pramod Sahu</p>
        <p class="meta mt-1">{SITE.role}</p>
        <p class="meta mt-1">{SITE.location}</p>
        <p class="meta mt-1">
          <a href={`mailto:${EMAIL}`} class="link-quiet -mx-1 inline-block px-1 py-1 hover:text-accent">{EMAIL}</a>
        </p>
      </div>

      <div class="flex gap-10 sm:gap-16">
        <div>
          <h2 class="eyebrow">Elsewhere</h2>
          <ul class="mt-2 flex flex-col">
            <li>
              <a href="/contact" class="link-quiet -mx-1 block px-1 py-1">Contact</a>
            </li>
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    href={social.href}
                    rel="me noopener"
                    target="_blank"
                    class="link-quiet -mx-1 block px-1 py-1"
                  >
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="eyebrow">Writing</h2>
          <ul class="mt-2 flex flex-col">
            {
              PUBLICATIONS.map((publication) => (
                <li>
                  <a
                    href={publication.href}
                    rel="me noopener"
                    target="_blank"
                    class="link-quiet -mx-1 block px-1 py-1"
                  >
                    {publication.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="meta mt-8 border-t border-line pt-5">© {year} Pramod Sahu</p>
  </div>
</footer>
