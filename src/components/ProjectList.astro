---
export type ProjectListItem = {
  title: string;
  summary: string;
  href: string;
  /** Real creation date, ISO. Absent for client work — never invented. */
  date?: string;
  /** Preformatted "21 Sep 2026 · Agent Infrastructure" line. */
  meta?: string | null;
  /** Technologies actually used, joined for display. Null when undocumented. */
  tech?: string | null;
};

interface Props {
  items: ProjectListItem[];
}

const { items } = Astro.props;

---

<ul>
  {
    items.map((item) => {
      return (
        <li class="group/row border-t border-line py-5 first:border-t-0">
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h3 class="text-entry font-medium">
                <a href={item.href} class="entry-title -my-0.5 py-0.5">
                  {item.title}
                </a>
              </h3>

              {item.meta && (
                <p class="meta mt-1.5">
                  <time datetime={item.date}>{item.meta}</time>
                </p>
              )}

              <p class="copy mt-2">{item.summary}</p>

              {item.tech && <p class="meta mt-2 text-fg/70">{item.tech}</p>}
            </div>

            <svg
              class="arrow mt-1 size-3.5 shrink-0 text-fg-muted"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M3 8h10M9 4l4 4-4 4" />
            </svg>
          </div>
        </li>
      );
    })
  }
</ul>
