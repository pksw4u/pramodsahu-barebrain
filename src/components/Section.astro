---
/**
 * A section with a monospace label, a hairline rule and an optional aside.
 * The rule under every label is the main structural motif on the site.
 */
interface Props {
  label: string;
  id?: string;
  class?: string;
  innerClass?: string;
}

const { label, id, class: className, innerClass } = Astro.props;
---

<section id={id} class:list={['py-10 md:py-12', className]}>
  <div class="shell">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b border-line pb-3">
      <h2 class="eyebrow">{label}</h2>
      <div class="-my-1 shrink-0 py-1">
        <slot name="aside" />
      </div>
    </div>
    <div class={innerClass}>
      <slot />
    </div>
  </div>
</section>
