---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
}

const { href, external = false, class: className } = Astro.props;
---

<a
  href={href}
  class:list={['group/link inline-flex items-baseline gap-1.5', className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <slot />
  <svg
    class="arrow size-[0.85em] shrink-0 translate-y-[0.08em] text-accent"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M3 8h10M9 4l4 4-4 4"></path>
  </svg>
</a>
