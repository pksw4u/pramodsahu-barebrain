---
import { render } from 'astro:content';
import ArrowLink from '../../components/ArrowLink.astro';
import { KIND_LABEL, getProjects, hrefFor, metaLineFor, type Project } from '../../lib/projects';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      next: projects[(index + 1) % projects.length] as Project,
    },
  }));
}

const { project, next } = Astro.props;
const { Content } = await render(project);

const { title, summary, date, kind, client, role, stack, links } = project.data;

/** "21 Sep 2026 · Agent Infrastructure" — whichever parts are documented. */
const metaLine = metaLineFor(project);

const facts: { label: string; value: string }[] = [
  ...(kind ? [{ label: 'Kind', value: KIND_LABEL[kind] }] : []),
  ...(client ? [{ label: 'Client', value: client }] : []),
  ...(role ? [{ label: 'Role', value: role }] : []),
  ...(stack.length > 0 ? [{ label: 'Stack', value: stack.join(' · ') }] : []),
];
---

<Base title={title} path={hrefFor(project)} description={summary} type="article">
  <article class="shell pt-10 pb-4 md:pt-12">
    <nav aria-label="Breadcrumb" class="mb-8">
      <ArrowLink href="/work" class="meta link-quiet -my-1 py-1 hover:text-accent">Work</ArrowLink>
    </nav>

    <h1 class="text-display">{title}</h1>

    {metaLine && (
      <p class="meta mt-2.5">
        <time datetime={date}>{metaLine}</time>
      </p>
    )}

    <p class="mt-3 max-w-[46ch] text-[1.0625rem] leading-snug text-fg">{summary}</p>

    <div class="shell">
      <hr class="mt-8" />
    </div>

    {facts.length > 0 && (
      <dl class="grid grid-cols-1 gap-x-8 gap-y-5 py-6 sm:grid-cols-2">
        {facts.map((fact) => (
          <div>
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="mt-1.5">{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}

    <div class="prose mt-10">
      <Content />
    </div>

    {
      links.length > 0 && (
        <>
          <div class="shell">
            <hr class="mt-10" />
          </div>
          <div class="mt-5 flex flex-wrap items-center gap-x-7 gap-y-2">
            {links.map((link) => (
              <ArrowLink
                href={link.href}
                external={link.href.startsWith('http')}
                class="text-[0.9375rem]"
              >
                {link.label}
              </ArrowLink>
            ))}
          </div>
        </>
      )
    }
  </article>

  <!-- Next case study --------------------------------------------------- -->
  <nav
    aria-label="More work"
    class="shell mt-16 border-t border-line pt-8"
  >
    <p class="eyebrow">Next</p>
    <a href={hrefFor(next)} class="group/row mt-3 block max-w-[46ch]">
      <span class="entry-title -my-0.5 py-0.5 text-entry font-medium">{next.data.title}</span>
      <span class="copy mt-1.5 block">{next.data.summary}</span>
    </a>
  </nav>
</Base>
