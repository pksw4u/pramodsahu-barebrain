---
import ArrowLink from '../components/ArrowLink.astro';
import { EXPLORING, SITE, SOCIALS } from '../consts';
import Base from '../layouts/Base.astro';

const facts = [
  { label: 'Location', value: SITE.location },
  { label: 'Role', value: SITE.role },
  { label: 'Experience', value: '16+ years in medical documentation (2008–2025)' },
  { label: 'Education', value: 'B.Sc., Sambalpur University, Odisha' },
  { label: 'Languages', value: 'English, Hindi, Odia' },
  { label: 'Currently on', value: 'LangGraph, n8n, agent memory' },
];
---

<Base
  title="About"
  path="/about"
  description="Pramod Sahu is an AI Automation Specialist focused on agent orchestration, workflow automation, RAG, voice AI and document processing, with 16+ years in medical documentation."
>
  <section class="shell pt-12 pb-4 md:pt-14 md:pb-6">
    <h1 class="text-display">About</h1>
    <p class="mt-3 max-w-[48ch] text-[1.0625rem] leading-snug text-fg">
      I'm Pramod, an AI Automation Specialist focused on building practical AI systems across
      agent orchestration, workflow automation, RAG, voice AI and document processing.
    </p>
  </section>

  <div class="shell">
    <hr />
  </div>

  <section class="shell py-10 md:py-12">
    <div class="prose">
      <p>
        AI Automation Specialist with hands-on experience designing and building AI-powered
        business automation systems using n8n, Make.com, LLMs, APIs, webhooks, RAG, and AI
        agents. I build solutions that automate repetitive business processes across customer
        support, sales, lead management, document processing, and operations — experienced in
        developing AI chatbots, voice agents, intelligent workflows, and custom agentic systems
        using tools including Vapi, Twilio, LangGraph, LangChain, Pinecone, and Supabase.
      </p>
      <p>
        Before automation, I spent 16+ years in medical documentation: 2008–2016 as a
        Healthcare Data Analyst at MModal Global Services, then 2016–2025 as a Quality Analyst
        (Clinical Data) at Aquity Solutions India Pvt Ltd. That work trained me to read
        messy, high-stakes process detail — which is the part that has to come before any
        automation.
      </p>
      <p>
        I enjoy turning real-world business problems into practical, scalable automation
        solutions. My approach is simple: understand the process first, choose the least
        complicated technology that solves the problem, and build systems that are reliable,
        observable, and maintainable.
      </p>
      <p>
        Alongside building, I write and research about
        <strong>agentic systems and emerging AI technologies</strong> on BareBrain (Substack)
        and DEV — agent harness architecture, agent loop design, memory, tool orchestration,
        decision layers, failure recovery, and sandboxed execution.
      </p>
    </div>
  </section>

  <div class="shell">
    <hr />
  </div>

  <section class="shell py-10 md:py-12">
    <h2 class="eyebrow">Details</h2>
    <dl class="mt-4 grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
      {
        facts.map((fact) => (
          <div>
            <dt class="eyebrow">{fact.label}</dt>
            <dd class="mt-1.5">{fact.value}</dd>
          </div>
        ))
      }

      <div>
        <dt class="eyebrow">Links</dt>
        <dd class="mt-1.5 flex flex-wrap gap-x-4 gap-y-1">
          {
            SOCIALS.map((social) => (
              <a href={social.href} target="_blank" rel="me noopener" class="link-quiet -my-0.5 py-1">
                {social.label}
              </a>
            ))
          }
          <a href="mailto:spramod4ai@gmail.com" class="link-quiet -my-0.5 py-1">Email</a>
        </dd>
      </div>
    </dl>
  </section>

  <div class="shell">
    <hr />
  </div>

  <section class="shell py-10 md:py-12">
    <h2 class="eyebrow">Experience</h2>
    <ul class="mt-4">
      {
        [
          { period: '2025 – Now', org: 'Freelancer', role: 'AI Automation Specialist' },
          { period: '2023 – Now', org: 'BareBrain (Substack)', role: 'Founder / Writer' },
          { period: '2016 – 2025', org: 'Aquity Solutions India Pvt Ltd', role: 'Quality Analyst (Clinical Data)' },
          { period: '2008 – 2016', org: 'MModal Global Services', role: 'Healthcare Data Analyst' },
        ].map((item) => (
          <li class="border-t border-line py-4 first:border-t-0">
            <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <div>
                <p class="text-entry font-medium">{item.org}</p>
                <p class="meta mt-0.5">{item.role}</p>
              </div>
              <p class="meta shrink-0">{item.period}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="shell">
    <hr />
  </div>

  <section class="shell py-10 md:py-12">
    <h2 class="eyebrow">Certifications</h2>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
      {
        [
          'AI Agent Course — Hugging Face',
          'Prompt Engineering — DeepLearning.ai',
          'Deep Learning — DeepLearning.ai',
          'Machine Learning — Coursera',
          'Data Science — Coursera',
        ].map((item) => (
          <li class="meta">{item}</li>
        ))
      }
    </ul>
  </section>

  <div class="shell">
    <hr />
  </div>

  <section class="shell py-10 md:py-12">
    <h2 class="eyebrow">Currently exploring</h2>
    <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
      {
        EXPLORING.map((item) => (
          <li class="meta">{item}</li>
        ))
      }
    </ul>

    <p class="meta mt-8">
      The systems behind this are listed in
      <ArrowLink href="/work" class="link ml-1">the work</ArrowLink>.
    </p>
  </section>
</Base>
